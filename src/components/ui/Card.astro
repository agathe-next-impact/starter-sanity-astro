---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'block rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-lg',
    href && 'hover:border-primary-200',
    className,
  ]}
>
  <slot />
</Tag>
