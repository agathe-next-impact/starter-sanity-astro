---
import SanityImage from '../ui/SanityImage.astro';
import type { TeamMemberItem } from '../../lib/types';

interface Props {
  members: TeamMemberItem[];
  title?: string;
}

const { members, title = 'Notre equipe' } = Astro.props;

const demoMembers: TeamMemberItem[] = members.length > 0 ? members : [
  { name: 'Alice Martin', role: 'Directrice', bio: 'Passionnee de strategie digitale.' },
  { name: 'Thomas Bernard', role: 'Developpeur', bio: 'Expert en solutions web modernes.' },
  { name: 'Claire Dubois', role: 'Designer', bio: 'Creations visuelles impactantes.' },
];
---

<section class="py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">{title}</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {demoMembers.map((member) => (
        <div class="text-center">
          <div class="mx-auto w-32 h-32 rounded-full bg-gray-200 mb-4 overflow-hidden">
            {member.photo ? (
              <SanityImage
                source={member.photo}
                alt={member.photo.alt ?? member.name}
                width={128}
                height={128}
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-gray-400 text-4xl font-bold">
                {member.name.charAt(0)}
              </div>
            )}
          </div>
          <h3 class="text-lg font-semibold text-gray-900">{member.name}</h3>
          {member.role && <p class="text-sm text-primary-600 mb-2">{member.role}</p>}
          {member.bio && <p class="text-sm text-gray-600">{member.bio}</p>}
          {member.linkedinUrl && (
            <a
              href={member.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-2 text-sm text-gray-500 hover:text-primary-600 transition-colors"
              aria-label={`LinkedIn profile of ${member.name}`}
            >
              LinkedIn
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
