---
import type { FeatureData } from '../../lib/types';

interface Props {
  features: FeatureData[];
  title?: string;
}

const { features, title } = Astro.props;

const demoFeatures: FeatureData[] = features.length > 0 ? features : [
  { title: 'Rapide', description: 'Des performances optimales grace a Astro et le rendu statique.', icon: 'rocket' },
  { title: 'Administrable', description: 'Contenu entierement gerable via Sanity Studio.', icon: 'settings' },
  { title: 'Moderne', description: 'Stack technique moderne avec TypeScript et Tailwind CSS.', icon: 'sparkles' },
];
---

<section class="py-16 lg:py-24 bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {title && (
      <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">{title}</h2>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {demoFeatures.map((feature) => (
        <div class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          {feature.icon && (
            <div class="w-12 h-12 rounded-lg bg-primary-100 text-primary-600 flex items-center justify-center text-2xl mb-4">
              {feature.icon}
            </div>
          )}
          <h3 class="text-lg font-semibold text-gray-900 mb-2">{feature.title}</h3>
          {feature.description && (
            <p class="text-gray-600 leading-relaxed">{feature.description}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
