---
import type { FaqData } from '../../lib/types';

interface Props {
  items: FaqData[];
  title?: string;
}

const { items, title = 'Questions frequentes' } = Astro.props;

const demoItems: FaqData[] = items.length > 0 ? items : [
  { question: 'Quels sont vos delais de realisation ?', answer: 'Nous nous engageons a livrer votre projet dans les delais convenus, generalement entre 2 et 6 semaines selon la complexite.' },
  { question: 'Proposez-vous un support apres livraison ?', answer: 'Oui, nous proposons un support technique et des maintenances regulieres pour assurer le bon fonctionnement de votre site.' },
  { question: 'Quels moyens de paiement acceptez-vous ?', answer: 'Nous acceptons les virements bancaires et les paiements par carte bancaire. Un acompte de 30% est demande au demarrage.' },
];
---

<section class="py-16 lg:py-24 bg-gray-50">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">{title}</h2>

    <div class="space-y-4">
      {demoItems.map((item) => (
        <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 text-left font-medium text-gray-900 hover:bg-gray-50 transition-colors">
            {item.question}
            <svg class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180 shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-gray-600 leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
