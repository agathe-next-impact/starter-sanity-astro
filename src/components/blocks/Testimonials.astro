---
import SanityImage from '../ui/SanityImage.astro';
import type { TestimonialData } from '../../lib/types';

interface Props {
  testimonials: TestimonialData[];
  title?: string;
}

const { testimonials, title } = Astro.props;

const demoTestimonials: TestimonialData[] = testimonials.length > 0 ? testimonials : [
  { quote: 'Un service exceptionnel, je recommande vivement !', author: 'Marie Dupont', role: 'CEO, TechCorp' },
  { quote: 'Tres professionnel et a l\'ecoute de nos besoins.', author: 'Jean Martin', role: 'Directeur, AgencePlus' },
  { quote: 'Resultat au-dela de nos attentes, merci !', author: 'Sophie Laurent', role: 'Fondatrice, StartupXYZ' },
];
---

<section class="py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {title && (
      <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">{title}</h2>
    )}
    {!title && (
      <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Ce que disent nos clients</h2>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {demoTestimonials.map((testimonial) => (
        <blockquote class="bg-white rounded-xl p-8 shadow-sm border border-gray-100">
          <svg class="w-8 h-8 text-primary-200 mb-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="text-gray-700 leading-relaxed mb-4">{testimonial.quote}</p>
          <footer class="flex items-center gap-3">
            {testimonial.avatar && (
              <SanityImage
                source={testimonial.avatar}
                alt={testimonial.avatar.alt ?? testimonial.author}
                width={40}
                height={40}
                class="w-10 h-10 rounded-full object-cover"
              />
            )}
            <div>
              <cite class="not-italic font-semibold text-gray-900 text-sm">{testimonial.author}</cite>
              {testimonial.role && (
                <p class="text-xs text-gray-500">{testimonial.role}</p>
              )}
            </div>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
