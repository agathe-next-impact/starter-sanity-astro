import Article1 from '../article-1.astro';
import Article2 from '../article-2.astro';

const componentMap: Record<string, any> = {
  'hero-1': Hero1, 'hero-2': Hero2, 'hero-3': Hero3, 'hero-4': Hero4,
  'hero-5': Hero5, 'hero-6': Hero6, 'hero-7': Hero7, 'hero-8': Hero8,
  'hero-9': Hero9, 'hero-10': Hero10, 'hero-11': Hero11, 'hero-12': Hero12,
  'hero-13': Hero13,
  'features-1': Features1, 'features-2': Features2, 'features-3': Features3,
  'features-4': Features4, 'features-5': Features5, 'features-6': Features6,
  'services-1': Services1, 'services-2': Services2, 'services-3': Services3,
  'services-4': Services4, 'services-5': Services5, 'services-6': Services6,
  'services-7': Services7,
  'faqs-1': Faqs1, 'faqs-2': Faqs2, 'faqs-3': Faqs3, 'faqs-4': Faqs4,
  'reviews-1': Reviews1, 'reviews-2': Reviews2, 'reviews-3': Reviews3,
  'reviews-4': Reviews4, 'reviews-5': Reviews5,
  'cta-1': Cta1, 'cta-2': Cta2, 'cta-3': Cta3, 'cta-4': Cta4,
  'cta-5': Cta5, 'cta-6': Cta6, 'cta-7': Cta7, 'cta-8': Cta8,
  'pricings-1': Pricings1, 'pricings-2': Pricings2, 'pricings-3': Pricings3,
  'contact-1': Contact1, 'contact-2': Contact2, 'contact-3': Contact3,
  'content-1': Content1, 'content-2': Content2, 'content-3': Content3,
  'content-4': Content4, 'content-5': Content5, 'content-6': Content6,
  'logos-1': Logos1, 'logos-2': Logos2, 'logos-3': Logos3,
  'articles-1': Articles1, 'articles-2': Articles2, 'articles-3': Articles3,
  'articles-4': Articles4,
  'banner-1': Banner1, 'banner-2': Banner2,
  'header-1': Header1, 'header-2': Header2, 'header-3': Header3,
  'footer-1': Footer1, 'footer-2': Footer2,
  'product-1': Product1, 'products-1': Products1, 'products-2': Products2,
  'products-3': Products3, 'products-4': Products4, 'products-5': Products5,
  'article-1': Article1, 'article-2': Article2,
};

interface Props {
  block: any;
}

const { block } = Astro.props;
const variant = block.variant;
const Component = componentMap[variant];

if (!Component) {
  console.warn(`Unknown block variant: ${variant}`);
}

const props = transformBlock(block);

// Build slot HTML from title/description (used by most blocks via <slot />)
const isBanner = block._type === 'bannerBlock';
const slotParts: string[] = [];
if (!isBanner && block.title) slotParts.push(`<h2>${block.title}</h2>`);
if (!isBanner && block.description) slotParts.push(`<p>${block.description}</p>`);
const slotContent = slotParts.join('');
---

{Component && (
  <Component {...props}>
    {slotContent && <Fragment set:html={slotContent} />}
  </Component>
)}
